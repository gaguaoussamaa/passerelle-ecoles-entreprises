# =============================================================================
# Passerelle — modèle de configuration de PRODUCTION (à copier en .env sur le
# serveur, puis compléter). Aucun secret réel ici : uniquement des placeholders.
# Durcissements par rapport au mode démo (.env.example) commentés ci-dessous.
# =============================================================================

APP_NAME=Passerelle
APP_ENV=production          # <- pas "local" : désactive les fonctions de debug
APP_KEY=                    # <- OBLIGATOIRE : `php artisan key:generate` (chiffrement, cookies)
APP_DEBUG=false             # <- pas de page d'erreur Ignition (aucune divulgation d'infos)
APP_URL=https://passerelle.exemple.fr   # <- HTTPS (liens d'invitation générés en https)

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# --- Journalisation : pas de niveau "debug" en prod ; rotation quotidienne ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Base de données (identifiants dédiés, PAS ceux de la démo) ---
DB_CONNECTION=mysql
DB_HOST=CHANGER_MOI
DB_PORT=3306
DB_DATABASE=CHANGER_MOI
DB_USERNAME=CHANGER_MOI
DB_PASSWORD=CHANGER_MOI

# --- Sessions : cookies durcis pour HTTPS ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true        # <- chiffrement des données de session
SESSION_SECURE_COOKIE=true  # <- cookie envoyé uniquement en HTTPS
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local        # stockage privé (hors racine web) ; envisager le chiffrement au repos
QUEUE_CONNECTION=database
CACHE_STORE=database         # (ou redis) — partagé si plusieurs instances (throttle cohérent)

BCRYPT_ROUNDS=12

# --- Messagerie réelle (remplacer Mailpit) ---
MAIL_MAILER=smtp
MAIL_HOST=CHANGER_MOI
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=CHANGER_MOI
MAIL_PASSWORD=CHANGER_MOI
MAIL_FROM_ADDRESS=notifications@passerelle.exemple.fr
MAIL_FROM_NAME="Passerelle"

# =============================================================================
# À FAIRE AUSSI côté infrastructure (hors .env) :
#   - Terminaison TLS + en-tête HSTS au reverse-proxy ; TrustProxies si proxy.
#   - `php artisan config:cache route:cache` au déploiement.
#   - Sauvegardes chiffrées ; rétention/purge des journaux de sécurité (RGPD).
#   - Contrôle anti-fuite des mots de passe (HIBP) si activé.
# =============================================================================
